# --- Target device ---------------------------------------------------------
# Raspberry Pi Compute Module 5 (BCM2712, aarch64).
# CONFIRM the exact pmaports device codename with `pmbootstrap init` device list
# (candidates: raspberry-pi5 / raspberry-pi-cm5). Change here only.
DEVICE=raspberry-pi5
ARCH=aarch64

# Phosh — the postmarketOS graphical (Wayland) shell. The hardening fragment
# now disables Bluetooth and sound only; **Wi-Fi was deliberately re-enabled on
# 2026-08-03** because the device needs wireless networking. The display stack
# (VC4/V3D DRM) is left enabled so the GUI renders. See
# config/disabled-subsystems.fragment for how to turn Wi-Fi back off.
UI=phosh

# Init system, and therefore the pmaports CHANNEL. This must be declared, not
# left to default, because it decides where built packages land:
#   always -> channel "systemd-edge" -> $work/packages/systemd-edge/$ARCH/
#   never  -> channel "edge"         -> $work/packages/edge/$ARCH/
# If the kernel is built under one channel and `pmbootstrap install` runs under
# another, install never looks in the build's directory and apk SILENTLY
# installs the stock kernel from the binary repo instead — an image that boots
# perfectly with none of the hardening applied. That is exactly what happened on
# 2026-08-03. build.sh now also verifies the installed kernel after install.
#
# "always" is chosen because it is the combination booted and confirmed working
# on real hardware. Phosh also runs fine on OpenRC ("never"), which was the
# earlier documented choice — but changing this changes the channel, so any
# switch requires a kernel rebuild into the new channel's package dir.
SYSTEMD=always

# --- Version / channel pins ------------------------------------------------
# pmOS/Alpine release channel. Pin to a stable release, NOT "edge", so the
# package set does not drift under us.
PMOS_RELEASE=v24.06

# Exact pmaports.git commit. Pinned to the tip of the v24.06 release branch
#   git ls-remote https://gitlab.postmarketos.org/postmarketOS/pmaports.git refs/heads/v24.06
PMAPORTS_REF=b2ec188d30f6408585d44e7f6473142e4c052a18

# pmbootstrap git tag. MUST match the version pinned in docker/Dockerfile.
PMBOOTSTRAP_VERSION=3.10.3

# --- Kernel package --------------------------------------------------------
# The pmaports kernel aport whose .config we harden. Leave empty to let
# apply-fragment.sh auto-detect it from the device's kernel config file; set it
# explicitly (e.g. linux-postmarketos-rpi) if auto-detection is ambiguous.
KERNEL_PKG=linux-rpi

# --- Build diagnostics -----------------------------------------------------
# Sample how the kernel build is actually executing (native vs emulated, and how
# parallel), writing out/build-diagnostics.log. Cheap — one `ps` every 20s — and
# it is the only way to tell apart the three causes of a slow build: crossdirect
# falling back to QEMU, too few abuild jobs, or the emulated-glue tax.
BUILD_DIAGNOSTICS=1

# Let the watchdog re-register the F-flagged binfmt entry if it disappears
# mid-build. LEAVE AT 0 until build-diagnostics.log actually shows the flag being
# wiped: fix-binfmt.sh unregisters before it registers, and a foreign exec landing
# in that window dies with ENOEXEC and takes the build with it.
BINFMT_WATCHDOG_HEAL=0

# --- Paths -----------------------------------------------------------------
# Where `pmbootstrap export` drops the final image(s), relative to repo root.
OUTPUT_DIR=out
