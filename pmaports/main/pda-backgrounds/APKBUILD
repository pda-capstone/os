# Maintainer: Tanner Weber <tannerw@pdx.edu>
pkgname=pda-backgrounds
pkgver=0.1.0
pkgrel=0
pkgdesc="Background wallpaper images for Pocket Distro Alpha"
url="https://github.com/pda-capstone"
arch="noarch"
license="GPL-3.0-or-later"
source="
	pda-background-d.png
	pda-background-l.png
	pda-background.xml
	20_pda-wallpaper.gschema.override
	"
options="!check"

package() {
	install -Dm644 -t "$pkgdir"/usr/share/backgrounds/pda/ \
		"$srcdir"/pda-background-d.png \
		"$srcdir"/pda-background-l.png
	install -Dm644 -t "$pkgdir"/usr/share/gnome-background-properties/ \
		"$srcdir"/pda-background.xml
	install -Dm644 -t "$pkgdir"/usr/share/glib-2.0/schemas/ \
		"$srcdir"/20_pda-wallpaper.gschema.override
}

